---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { sized } from '../lib/img';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => base + '/' + p.replace(/^\//, '');

const posts = await getCollection('posts', ({ data }) => !data.draft);
const TOPICS = [
  { key: 'arriving', title: 'Arriving and staying legal' },
  { key: 'money', title: 'Money, phone and paperwork' },
  { key: 'home', title: 'Your home' },
  { key: 'health', title: 'Health' },
  { key: 'daily', title: 'Getting around and daily life' },
].map((t) => {
  const group = posts.filter((p) => p.data.topic === t.key);
  return { ...t, count: group.length, photo: group.find((p) => p.data.hero)?.data.hero };
});

const PHOTO = {
  src: 'https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/Myeongdong%2C_Seoul_-_Myeongdong3165.jpg/1920px-Myeongdong%2C_Seoul_-_Myeongdong3165.jpg',
  page: 'https://commons.wikimedia.org/wiki/File:Myeongdong,_Seoul_-_Myeongdong3165.jpg',
  credit: 'lumoplank, CC0, via Wikimedia Commons',
};
---

<Base title="About" description="Who writes Seoul Settled, and how every guide is checked against official sources.">
  <section class="wrap page about">
    <div class="about-head">
      <h1 data-rise>Written in Seoul.</h1>
      <a class="cta" data-rise style="--rise-delay:90ms" href={href('how-to-get-arc-korea/')}>Start with the ARC guide</a>
    </div>

    <figure class="about-photo" data-rise style="--rise-delay:60ms">
      <img src={sized(PHOTO.src, 1280)} alt="A street in Myeongdong, Seoul" fetchpriority="high" decoding="async" />
      <figcaption class="credit">Photo: <a href={PHOTO.page} rel="nofollow noopener">{PHOTO.credit}</a></figcaption>
    </figure>

    <div class="about-body">
      <div class="about-prose">
        <p data-rise>Hi, I'm Jun. I live in Seoul and write Seoul Settled to answer the questions I kept
        running into — and kept seeing other foreigners ask — about the practical side of living here:
        getting your ARC, opening a bank account, choosing jeonse or wolse, sorting your trash right the
        first time.</p>

        <p data-rise>Most "moving to Korea" content is outdated, written for tourists rather than
        residents, or vague enough that you still end up calling the government office to confirm the
        real answer. These guides are written the way I'd explain it to a friend who just landed: step by
        step, with the specific numbers, forms and gotchas that actually trip people up.</p>

        <h2 data-rise>How every guide is checked</h2>
        <ol class="method" data-rise>
          <li><b>One official source per fact.</b> Every deadline, fee and document list links to the
          government page it comes from — Hi Korea, the Ministry of Justice, NHIS, the Seoul city guides.</li>
          <li><b>Korean pages over English ones.</b> Government English pages often lag the Korean
          originals, so numbers are checked against both.</li>
          <li><b>Links re-checked.</b> Sources are re-checked regularly; when a rule changes, the guide
          changes with it.</li>
          <li><b>Counted conservatively.</b> Where a deadline could be read two ways, you get the
          earlier date.</li>
        </ol>

        <h2 data-rise>A note on accuracy</h2>
        <p data-rise>Rules change. Every guide links to the page it is based on so you can confirm the
        current rule yourself. Don't treat any blog — this one included — as a replacement for checking the
        official page before a deadline-sensitive decision.</p>
      </div>

    </div>

    <section class="covered">
      <h2 data-rise>What's covered</h2>
      <ul class="covered-grid">
        {TOPICS.map((t, i) => (
          <li data-rise style={`--rise-delay:${i * 60}ms`}>
            <a href={href('#' + t.key)}>
              {t.photo && <img src={sized(t.photo.src, 500)} alt="" loading="lazy" decoding="async" />}
              <span class="covered-title">{t.title}</span>
              <span class="covered-count">{t.count} {t.count === 1 ? 'guide' : 'guides'}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </section>
</Base>
