---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const href = (p: string) => (base.replace(/\/$/, '') + '/' + p.replace(/^\//, ''));

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base
  title="Seoul Settled"
  description="Practical, step-by-step guides to living in Korea — visas, banking, housing, healthcare and everyday life, checked against official sources."
>
  <section class="wrap lede">
    <h1>The parts of moving to Korea nobody explains.</h1>
    <p>
      Step-by-step guides to the paperwork, the deadlines and the daily logistics — written
      in Seoul, and checked against the government pages they come from.
    </p>
  </section>

  <div class="wrap">
    <p class="index-head">All guides · {posts.length}</p>
    <ul class="index">
      {posts.map((post) => (
        <li>
          <a class={`entry${post.data.keyFact ? ' has-fact' : ''}`} href={href(post.data.slug + '/')}>
            <h2 class="entry-title">{post.data.title}</h2>
            <p class="entry-desc">{post.data.description}</p>
            <p class="entry-meta">
              <span>{fmt(post.data.date)}</span>
              {post.data.tags.slice(0, 2).map((t) => <span>{t}</span>)}
            </p>
            {post.data.keyFact && (
              <p class="entry-fact">
                <b>{post.data.keyFact.value}</b>
                <small>{post.data.keyFact.label}</small>
              </p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
